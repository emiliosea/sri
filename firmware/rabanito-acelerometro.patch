+// ---------------------------------------------------------------------------------------------
+// SRI: tabla de nodos de campo escuchados (para la pantalla de la base). Ver SriCampo.h.
+// ---------------------------------------------------------------------------------------------
+SriNodo sri_nodos[SRI_MAX_NODOS];
+
+static SriNodo* sri_buscar(const uint8_t* id, const char* nombre) {
+  SriNodo* libre = NULL;
+  SriNodo* viejo = NULL;
+  for (int i = 0; i < SRI_MAX_NODOS; i++) {
+    SriNodo* n = &sri_nodos[i];
+    if (!n->usado) { if (!libre) libre = n; continue; }
+    if (id && memcmp(n->id, id, 4) == 0) return n;
+    if (!id && nombre && strcmp(n->nombre, nombre) == 0) return n;
+    if (!viejo || (long)(n->visto_ms - viejo->visto_ms) < 0) viejo = n;
+  }
+  SriNodo* n = libre ? libre : viejo;              // tabla llena: se reemplaza el que lleva más sin oírse
+  memset(n, 0, sizeof(*n));
+  n->usado = true;
+  if (id) {
+    memcpy(n->id, id, 4);
+    mesh::Utils::toHex(n->nombre, n->id, 4);
+  }
+  if (nombre) { strncpy(n->nombre, nombre, sizeof(n->nombre) - 1); n->nombre[sizeof(n->nombre) - 1] = 0; }
+  return n;
+}
+
+static bool sri_hex4(const char* p, uint8_t* out) {
+  for (int i = 0; i < 4; i++) {
+    unsigned v;
+    if (!isxdigit((unsigned char)p[2*i]) || !isxdigit((unsigned char)p[2*i+1]) || sscanf(p + 2*i, "%2x", &v) != 1)
+      return false;
+    out[i] = (uint8_t)v;
+  }
+  return true;
+}
+
+SriNodo* sriCampoTexto(const char* text) {
+  const char* sep = strstr(text, ": SRI1 ");
+  if (!sep) return NULL;
+  char nombre[17];
+  int ln = sep - text;
+  if (ln > 16) ln = 16;
+  memcpy(nombre, text, ln); nombre[ln] = 0;
+  const char* cuerpo = sep + 7;
+  uint8_t id[4];
+  const char* pi = strstr(cuerpo, " i");
+  bool hay_id = false;
+  while (pi) {                                        // " i" seguido de 8 hex (la identidad, sri5)
+    if (strlen(pi + 2) >= 8 && sri_hex4(pi + 2, id)) { hay_id = true; break; }
+    pi = strstr(pi + 2, " i");
+  }
+  SriNodo* n = sri_buscar(hay_id ? id : NULL, nombre);
+  strncpy(n->nombre, nombre, sizeof(n->nombre) - 1);
+  n->visto_ms = millis();
+  if (strncmp(cuerpo, "POS ", 4) == 0) {
+    const char* pb = strstr(cuerpo, " b");
+    if (pb) n->mv = (uint16_t)atol(pb + 2);
+  } else if (strncmp(cuerpo, "CAIDA", 5) == 0 || strncmp(cuerpo, "GOLPE", 5) == 0) {
+    memcpy(n->tipo, cuerpo, 5); n->tipo[5] = 0;
+    n->alerta = true;
+    n->alerta_ms = millis();
+  }
+  return n;
+}
+
+SriNodo* sriCampoDatos(uint16_t data_type, const uint8_t* d, size_t len) {
+  if (data_type != SRI_DATA_TYPE || len < 25 || d[0] != 1) return NULL;
+  SriNodo* n = sri_buscar(&d[1], NULL);
+  n->visto_ms = millis();
+  n->mv = (uint16_t)(d[13] | (d[14] << 8));
+  n->moviendo = d[23] & 1;
+  return n;
+}
+
+int sriBateriaPct(uint16_t mv) {
+  if (!mv) return -1;
+  int p = (int)((mv - 3300L) * 100L / (4150 - 3300));
+  return p < 0 ? 0 : (p > 100 ? 100 : p);
+}
