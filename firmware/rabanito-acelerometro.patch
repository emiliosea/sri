+#pragma once
+// SRI: nodos de campo que la base (FARO) escucha por el canal "SRI". Los llena MyMesh al recibir reportes y
+// alertas (texto "SRI1 ..." o el binario sri7, data_type 0xFF53) y los muestra la pantalla (ui-new/UITask.cpp).
+#include <Arduino.h>
+
+#define SRI_MAX_NODOS 6
+
+struct SriNodo {
+  bool usado;
+  uint8_t id[4];            // inicio de la llave pública del nodo
+  char nombre[17];          // del reporte en texto; mientras no llega, el id en hex
+  unsigned long visto_ms;   // millis() del último reporte
+  uint16_t mv;              // batería (0 = sin dato)
+  bool moviendo;
+  bool alerta;              // hubo una caída/golpe que la pantalla debe mostrar
+  char tipo[7];             // "CAIDA" / "GOLPE"
+  unsigned long alerta_ms;
+};
+
+extern SriNodo sri_nodos[SRI_MAX_NODOS];
+
+// Procesan un mensaje del canal "SRI". Devuelven el nodo actualizado (o NULL si no era de SRI).
+SriNodo* sriCampoTexto(const char* text);
+SriNodo* sriCampoDatos(uint16_t data_type, const uint8_t* data, size_t len);
+// Batería en % aproximado (igual que SRI en la PC).
+int sriBateriaPct(uint16_t mv);
