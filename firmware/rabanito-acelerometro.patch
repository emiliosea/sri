+// ---------------------------------------------------------------------------------------------
+// SRI (Sistema de Respuesta Inmediata): cuando el detector de caídas del nodo engancha un evento
+// (variable "alerta" del SensorManager), se manda un mensaje al canal de grupo "SRI", sin necesitar
+// la app ni la PC. Los mensajes de canal no tienen acuse de recibo: se repite 3 veces, cada 20 s.
+//   SRI1 CAIDA dif 7.97g pico 8.79g @25.662300,-100.422100 t1794705000 #3 (1/3)
+// Sin canal "SRI" configurado no se manda nada (la alarma sigue en el nodo y en la PC conectada).
+// ---------------------------------------------------------------------------------------------
+void MyMesh::alertaSRI() {
+  static unsigned long proxima = 0;
+  static uint8_t enviados = 0;
+  static char ultima[64] = "";
+  if (proxima && !millisHasNowPassed(proxima)) return;
+  proxima = futureMillis(1000);
+
+  const char* a = sensors.getSettingByKey("alerta");
+  if (a == NULL || a[0] == 0 || strcmp(a, "-") == 0) { enviados = 0; ultima[0] = 0; return; }
+  if (strcmp(a, ultima) != 0) {                         // evento nuevo: empezar de cero
+    strncpy(ultima, a, sizeof(ultima) - 1);
+    ultima[sizeof(ultima) - 1] = 0;
+    enviados = 0;
+  }
+  if (enviados >= 3) { sensors.setSettingValue("alerta", "0"); return; }
+
+  ChannelDetails ch;
+  int idx = -1;
+#ifdef MAX_GROUP_CHANNELS
+  for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+    if (getChannel(i, ch) && strcmp(ch.name, "SRI") == 0) { idx = i; break; }
+  }
+#endif
+  if (idx < 0) { sensors.setSettingValue("alerta", "0"); return; }
+
+  // "tipo|pico*100|dif*100|epoch|cuenta"
+  char tipo[8] = "?";
+  long pico = 0, dif = 0;
+  unsigned long epoch = 0, cuenta = 0;
+  const char* p = a;
+  int k = 0;
+  while (*p && *p != '|' && k < 7) tipo[k++] = (char)toupper(*p++);
+  tipo[k] = 0;
+  if (*p == '|') pico = strtol(p + 1, (char**)&p, 10);
+  if (*p == '|') dif = strtol(p + 1, (char**)&p, 10);
+  if (*p == '|') epoch = strtoul(p + 1, (char**)&p, 10);
+  if (*p == '|') cuenta = strtoul(p + 1, (char**)&p, 10);
+
+  char pos[40] = "";
+  if (sensors.node_lat != 0 || sensors.node_lon != 0) {
+    // en millonésimas de grado con enteros (no depende de que printf soporte decimales)
+    long la = lround(sensors.node_lat * 1000000.0), lo = lround(sensors.node_lon * 1000000.0);
+    snprintf(pos, sizeof(pos), " @%s%ld.%06ld,%s%ld.%06ld", la < 0 ? "-" : "", labs(la) / 1000000, labs(la) % 1000000,
+             lo < 0 ? "-" : "", labs(lo) / 1000000, labs(lo) % 1000000);
+  }
+  char id[9];
+  mesh::Utils::toHex(id, self_id.pub_key, 4);          // sri5: identidad fija del nodo (no depende del nombre)
+  char txt[150];
+  snprintf(txt, sizeof(txt), "SRI1 %s dif %ld.%02ldg pico %ld.%02ldg%s t%lu #%lu (%u/3) i%s", tipo, dif / 100,
+           labs(dif) % 100, pico / 100, labs(pico) % 100, pos, epoch, cuenta, (unsigned)(enviados + 1), id);
+
+  uint32_t ts = getRTCClock()->getCurrentTimeUnique();
+  if (sendGroupMessage(ts, ch.channel, _prefs.node_name, txt, strlen(txt))) {
+    enviados++;
+    MESH_DEBUG_PRINTLN("SRI: alerta enviada (%u/3): %s", (unsigned)enviados, txt);
+    proxima = futureMillis(enviados < 3 ? 20000 : 1000);
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// SRI: reporte del nodo de campo por el canal privado "SRI" (no en el anuncio público): posición GPS, batería,
+// temperatura y aceleración, para que la base (FARO) y SRI vean al senderista aunque no haya alerta.
+//
+// sri7 - adaptativo y compacto:
+//  * Cada "rapido_s" (3 s) mientras se mueve y hasta 20 s después del último movimiento; cada "reporte_s" (30 s)
+//    en reposo. Las dos se cambian sin recompilar (variables del SensorManager; vuelven al valor por defecto al
+//    reiniciar). Las caídas siguen saliendo al momento como alertas (alertaSRI).
+//  * Casi todos los reportes van en BINARIO (datagrama de canal, data_type 0xFF53, 25 bytes): ~0.3 s de aire en
+//    vez de ~0.65 s del texto. Cada 60 s va uno en TEXTO, que lleva el nombre del nodo y se lee en la app:
+//      SRI1 POS @25.662300,-100.422100 t1794705000 b3920 e3 a0.92/1.85 c23.7 id9a3737d
+//  Formato binario (little endian), versión 1:
+//    [0] versión=1 | [1..4] id (4 bytes de la llave) | [5..8] lat*1e6 (int32; 0 = sin GPS) | [9..12] lon*1e6
+//    [13..14] batería mV | [15..16] s desde la última posición GPS (0xFFFF = nunca)
+//    [17..18] acel. mín (centésimas de g; 0xFFFF = sin dato) | [19..20] acel. máx | [21..22] temp (décimas de °C,
+//    int16; 0x8000 = sin dato) | [23] banderas (bit0 = en movimiento) | [24] número de reporte (0-255, vuelve a 0)
+// Formato completo para nodos de campo propios: docs/firmware.md. Solo si hay canal "SRI" y el nodo tiene GPS o
+// acelerómetro. Mientras sale una alerta no se manda reporte (la alerta ya lleva la posición).
+// ---------------------------------------------------------------------------------------------
+#define SRI_DATA_TYPE        0xFF53     // rango de pruebas de MeshCore (0xFF00-0xFFFE), no requiere registro
+#define SRI_RAPIDO_MS        (3UL * 1000UL)
+#define SRI_LENTO_MS         (30UL * 1000UL)
+#define SRI_TEXTO_CADA_MS    (60UL * 1000UL)
+#define SRI_MOVIMIENTO_S     20         // "en movimiento" hasta 20 s después del último movimiento
+
+static void sri_put16(uint8_t* b, uint16_t v) { b[0] = v & 0xFF; b[1] = v >> 8; }
+static void sri_put32(uint8_t* b, int32_t v) {
+  uint32_t u = (uint32_t)v;
+  b[0] = u & 0xFF; b[1] = (u >> 8) & 0xFF; b[2] = (u >> 16) & 0xFF; b[3] = u >> 24;
+}
+
+void MyMesh::posicionSRI() {
+  static unsigned long proxima = 0, ultimo_texto = 0;
+  static uint8_t seq = 0;
+  static bool texto_hecho = false;
+
+  // Datos del SensorManager: "resumen" = mín*100|máx*100|edad GPS|temp*10|s desde el último movimiento
+  const char* r = sensors.getSettingByKey("resumen");
+  long rmin = -1, rmax = -1, edad = -1, temp10 = -9999, mov = -1;
+  bool hay_acel = false;
+  if (r != NULL && r[0]) {
+    hay_acel = r[0] != '-';
+    const char* q = r;
+    long campos[5] = {-1, -1, -1, -9999, -1};
+    for (int k = 0; k < 5 && q; k++) {
+      if (*q != '-' || (q[1] >= '0' && q[1] <= '9')) campos[k] = strtol(q, NULL, 10);
+      q = strchr(q, '|');
+      if (q) q++;
+    }
+    if (hay_acel) { rmin = campos[0]; rmax = campos[1]; }
+    edad = campos[2]; temp10 = campos[3]; mov = campos[4];
+  }
+  bool moviendo = mov >= 0 && mov <= SRI_MOVIMIENTO_S;
+
+  unsigned long lento = SRI_LENTO_MS, rapido = SRI_RAPIDO_MS;
+  const char* iv = sensors.getSettingByKey("reporte_s");
+  if (iv != NULL && atol(iv) >= 5 && atol(iv) <= 600) lento = (unsigned long)atol(iv) * 1000UL;
+  iv = sensors.getSettingByKey("rapido_s");
+  if (iv != NULL && atol(iv) >= 2 && atol(iv) <= 60) rapido = (unsigned long)atol(iv) * 1000UL;
+  unsigned long intervalo = moviendo ? rapido : lento;
+
+  if (proxima == 0) { proxima = futureMillis(5000); return; }        // el primero, 5 s después de encender
+  // Si empezó a moverse y faltaba mucho para el reporte lento, adelantarlo
+  if (moviendo && (long)(proxima - millis()) > (long)rapido) proxima = futureMillis(rapido);
+  if (!millisHasNowPassed(proxima)) return;
+
+  const char* a = sensors.getSettingByKey("alerta");
+  if (a != NULL && a[0] != 0 && strcmp(a, "-") != 0 && strcmp(a, "0") != 0) {
+    proxima = futureMillis(rapido);                       // hay una alerta saliendo: esperar
+    return;
+  }
+  proxima = futureMillis(intervalo);
+
+  // Sin posición GPS y sin acelerómetro no hay nada que mandar (p. ej. FARO).
+  if (sensors.node_lat == 0 && sensors.node_lon == 0 && !hay_acel) return;
+
+  ChannelDetails ch;
+  int idx = -1;
+#ifdef MAX_GROUP_CHANNELS
+  for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+    if (getChannel(i, ch) && strcmp(ch.name, "SRI") == 0) { idx = i; break; }
+  }
+#endif
+  if (idx < 0) return;
+
+  long la = lround(sensors.node_lat * 1000000.0), lo = lround(sensors.node_lon * 1000000.0);
+  uint16_t mv = (uint16_t)board.getBattMilliVolts();
+  bool enviado = false;
+
+  if (!texto_hecho || millisHasNowPassed(ultimo_texto + SRI_TEXTO_CADA_MS)) {
+    // ---- reporte en texto (lleva el nombre) ----
+    char extra[60] = "";
+    int n = snprintf(extra, sizeof(extra), " e%ld", edad);
+    if (hay_acel && n > 0 && n < (int)sizeof(extra))
+      n += snprintf(extra + n, sizeof(extra) - n, " a%ld.%02ld/%ld.%02ld", rmin / 100, rmin % 100, rmax / 100, rmax % 100);
+    if (temp10 != -9999 && n > 0 && n < (int)sizeof(extra))
+      snprintf(extra + n, sizeof(extra) - n, " c%s%ld.%ld", temp10 < 0 ? "-" : "", labs(temp10) / 10, labs(temp10) % 10);
+    char id[9];
+    mesh::Utils::toHex(id, self_id.pub_key, 4);
+    char txt[160];
+    snprintf(txt, sizeof(txt), "SRI1 POS @%s%ld.%06ld,%s%ld.%06ld t%lu b%u%s i%s",
+             la < 0 ? "-" : "", labs(la) / 1000000, labs(la) % 1000000,
+             lo < 0 ? "-" : "", labs(lo) / 1000000, labs(lo) % 1000000,
+             (unsigned long)getRTCClock()->getCurrentTime(), (unsigned)mv, extra, id);
+    uint32_t ts = getRTCClock()->getCurrentTimeUnique();
+    enviado = sendGroupMessage(ts, ch.channel, _prefs.node_name, txt, strlen(txt));
+    if (enviado) { ultimo_texto = millis(); texto_hecho = true; }
+  } else {
+    // ---- reporte binario compacto ----
+    uint8_t b[25];
+    b[0] = 1;
+    memcpy(&b[1], self_id.pub_key, 4);
+    sri_put32(&b[5], (int32_t)la);
+    sri_put32(&b[9], (int32_t)lo);
+    sri_put16(&b[13], mv);
+    sri_put16(&b[15], edad < 0 ? 0xFFFF : (edad > 0xFFFE ? 0xFFFE : (uint16_t)edad));
+    sri_put16(&b[17], hay_acel ? (uint16_t)rmin : 0xFFFF);
+    sri_put16(&b[19], hay_acel ? (uint16_t)rmax : 0xFFFF);
+    sri_put16(&b[21], temp10 == -9999 ? 0x8000 : (uint16_t)(int16_t)temp10);
+    b[23] = moviendo ? 1 : 0;
+    b[24] = seq;
+    enviado = sendGroupData(ch.channel, NULL, OUT_PATH_UNKNOWN, SRI_DATA_TYPE, b, sizeof(b));
+    if (enviado) seq++;
+  }
+  if (enviado) {
+    sensors.setSettingValue("resumen", "0");          // empezar otro intervalo de mín/máx
+  } else {
+    proxima = futureMillis(rapido);
+  }
 }
 
