+      snprintf(vbuf[3], sizeof(vbuf[3]), "%d.%02d", (int)umbral_g, (int)(umbral_g * 100) % 100);
+      return vbuf[3];
+    case 4:
+      if (!acc_ok) return "-";
+      if (acc_max == 0) { acc_min = acc_g; acc_max = acc_g; }   // sin lecturas nuevas
+      snprintf(vbuf[4], sizeof(vbuf[4]), "%d|%d|%d", (int)(acc_g * 100), (int)(acc_min * 100),
+               (int)(acc_max * 100));
+      acc_min = 99; acc_max = 0;                                 // empezar otro intervalo
+      return vbuf[4];
+    case 5:
+      if (!acc_ok || !ult_epoch) return "-";
+      snprintf(vbuf[5], sizeof(vbuf[5]), "%d|%d|%d|%lu", (int)(ult_pico * 100), (int)(ult_reposo * 100),
+               (int)(ult_dif * 100), (unsigned long)ult_epoch);
+      return vbuf[5];
+    case 6:
+      if (!alerta_pendiente) return "-";
+      snprintf(vbuf[6], sizeof(vbuf[6]), "%s|%d|%d|%lu|%u", impacto_tipo, (int)(impacto_pico * 100),
+               (int)(impacto_dif * 100), (unsigned long)impacto_epoch, (unsigned)impacto_cuenta);
+      return vbuf[6];
+    case 7: {
+      long edad = gps_fix_ms ? (long)((millis() - gps_fix_ms) / 1000) : -1;
+      long t10 = lroundf(t1000e_get_temperature() * 10.0f);
+      long mov = mov_ms ? (long)((millis() - mov_ms) / 1000) : -1;
+      if (!acc_ok || res_max == 0) snprintf(vbuf[7], sizeof(vbuf[7]), "-|-|%ld|%ld|%ld", edad, t10, mov);
+      else snprintf(vbuf[7], sizeof(vbuf[7]), "%d|%d|%ld|%ld|%ld", (int)(res_min * 100), (int)(res_max * 100), edad, t10, mov);
+      return vbuf[7];
+    }
+    case 8:
+      snprintf(vbuf[8], sizeof(vbuf[8]), "%u", (unsigned)reporte_s);
+      return vbuf[8];
+    case 9:
+      snprintf(vbuf[9], sizeof(vbuf[9]), "%u", (unsigned)rapido_s);
+      return vbuf[9];
   }
   return NULL;
 }
