+
+// ===========================================================================
+// Acelerómetro QMA6100P (I2C 0x12): detección de caídas y golpes
+// ===========================================================================
+#define QMA_ADDR        0x12
+#define QMA_CHIP_ID     0x90
+#define QMA_RANGO       0x0F      // registro 0x0F: 0x01=±2g 0x02=±4g 0x04=±8g 0x08=±16g 0x0F=±32g
+#define QMA_LSB_PER_G   256.0f    // rango ±32 g con datos de 14 bits: 16384 / 64 g = 256 por g
+#define ACC_PERIOD_MS   20        // 50 lecturas por segundo -> banco de 250 = 5 s
+#define QUIETO_N        50        // ventana para decidir "en reposo": último 1 s
+#define QUIETO_RANGO_G  0.15f     // en reposo si (máx - mín) del último segundo <= esto
+#define FREEFALL_G      0.35f     // por debajo de esto el nodo está "cayendo"
+#define FREEFALL_N      3         // 3 lecturas seguidas (60 ms) = caída libre
+
+static bool qma_write(uint8_t reg, uint8_t val) {
+  Wire.beginTransmission(QMA_ADDR);
+  Wire.write(reg);
+  Wire.write(val);
+  return Wire.endTransmission() == 0;
+}
+
+static bool qma_read(uint8_t reg, uint8_t* buf, uint8_t n) {
+  Wire.beginTransmission(QMA_ADDR);
+  Wire.write(reg);
+  if (Wire.endTransmission(false) != 0) return false;
+  if (Wire.requestFrom((uint8_t)QMA_ADDR, n) != n) return false;
+  for (uint8_t i = 0; i < n; i++) buf[i] = Wire.read();
+  return true;
+}
+
+void T1000SensorManager::acc_begin() {
+  digitalWrite(PIN_3V3_ACC_EN, HIGH);   // MeshCore deja apagada la alimentación del acelerómetro
+  delay(10);
+  uint8_t id = 0;
+  if (!qma_read(0x00, &id, 1) || id != QMA_CHIP_ID) {
+    acc_ok = false;
+    next_acc_retry_ms = millis() + 5000;  // reintentar más tarde
+    return;
+  }
+  qma_write(0x36, 0xB6); delay(5);      // reset por software
+  qma_write(0x36, 0x00); delay(5);
+  qma_write(0x11, 0x80);                // modo activo
+  qma_write(0x11, 0x84);
+  qma_write(0x4A, 0x20);                // secuencia de arranque recomendada por QST
+  qma_write(0x56, 0x01);
+  qma_write(0x5F, 0x80); delay(2);
+  qma_write(0x5F, 0x00); delay(10);
+  qma_write(0x0F, QMA_RANGO);           // rango ±32 g
+  acc_ok = true;
+}
+
+bool T1000SensorManager::acc_read(float& g) {
+  uint8_t b[6];
+  if (!qma_read(0x01, b, 6)) return false;
+  // 14 bits con signo, alineados a la izquierda en dos bytes por eje
+  float a[3];
+  for (int i = 0; i < 3; i++) {
+    a[i] = (int16_t)((b[2 * i + 1] << 8) | (b[2 * i] & 0xFC)) / 4 / QMA_LSB_PER_G;
+    raw_sum[i] += a[i];                               // promedio sin calibrar (telemetría)
+    a[i] = (a[i] - cal_off[i]) / cal_gain[i];         // corrección por eje
+  }
+  raw_n++;
+  g = sqrtf(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]);
   return true;
 }
 
+// Lectura del banco: edad 0 = lectura más reciente
+#define HIST_AT(age) hist[(hist_pos - 1 - (age) + HIST_N) % HIST_N]
+
+void T1000SensorManager::acc_loop() {
+  unsigned long now = millis();
+  if (!acc_ok) {
+    if ((long)(now - next_acc_retry_ms) >= 0) acc_begin();
+    return;
+  }
+  if ((long)(now - next_acc_ms) < 0) return;
+  next_acc_ms = now + ACC_PERIOD_MS;
+
+  float g;
+  if (!acc_read(g)) return;
+  acc_g = g;
+  if (g < acc_min) acc_min = g;
+  if (g > acc_max) acc_max = g;
+
+  // 1) Guardar en el banco circular de 5 s (milésimas de g)
+  float mg = g * 1000.0f;
+  hist[hist_pos] = (uint16_t)(mg > 65000.0f ? 65000.0f : mg);
+  hist_pos = (hist_pos + 1) % HIST_N;
+  if (hist_n < HIST_N) hist_n++;
+  if (hist_n < QUIETO_N) return;
+
+  // 2) ¿Está en reposo? La aceleración casi no cambia durante el último segundo
+  uint16_t lo = 65535, hi = 0;
+  for (int age = 0; age < QUIETO_N; age++) {
+    uint16_t v = HIST_AT(age);
+    if (v < lo) lo = v;
+    if (v > hi) hi = v;
+  }
+  bool ahora_quieto = (hi - lo) <= (uint16_t)(QUIETO_RANGO_G * 1000);
+
+  // 3) Al pasar de "en movimiento" a "en reposo": revisar el último pico
+  if (ahora_quieto && !quieto) acc_evaluar(now);
+  quieto = ahora_quieto;
+}
+
+void T1000SensorManager::acc_evaluar(unsigned long now) {
+  // Valor en reposo: promedio del último segundo
+  uint32_t suma = 0;
+  for (int age = 0; age < QUIETO_N; age++) suma += HIST_AT(age);
+  float reposo = suma / (float)QUIETO_N / 1000.0f;
+
+  // Pico: máximo de todo el banco (últimos 5 s) y cuántas lecturas atrás ocurrió
+  uint16_t pico_mg = 0;
+  int pico_age = 0;
+  for (int age = 0; age < hist_n; age++) {
+    uint16_t v = HIST_AT(age);
+    if (v > pico_mg) { pico_mg = v; pico_age = age; }
+  }
+
+  // ¿Hubo caída libre ANTES del pico? (lecturas más viejas que el pico)
+  bool fue_caida = false;
+  int racha = 0;
+  for (int age = pico_age + 1; age < hist_n; age++) {
+    if (HIST_AT(age) < (uint16_t)(FREEFALL_G * 1000)) {
+      if (++racha >= FREEFALL_N) { fue_caida = true; break; }
+    } else {
+      racha = 0;
+    }
+  }
+
+  float pico = pico_mg / 1000.0f;
+  float dif = pico - reposo;
+  uint32_t epoch_pico = rtc_clock.getCurrentTime() - (uint32_t)((pico_age * ACC_PERIOD_MS) / 1000);
+
+  // Se informa siempre (sirve para calibrar el umbral), alerte o no
+  ult_pico = pico; ult_reposo = reposo; ult_dif = dif; ult_epoch = epoch_pico;
+
+  if (dif >= umbral_g) {
+    strcpy(impacto_tipo, fue_caida ? "caida" : "golpe");
+    impacto_pico = pico;
+    impacto_reposo = reposo;
+    impacto_dif = dif;
+    impacto_epoch = epoch_pico;
+    impacto_cuenta++;
+    impacto = true;
+  }
+
+  // Vaciar el banco para no volver a contar el mismo pico
+  hist_n = 0;
+}
