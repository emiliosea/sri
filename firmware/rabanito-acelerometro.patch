+
+// ---------------------------------------------------------------------------------------------
+// SRI (Sistema de Respuesta Inmediata): cuando el detector de caídas del nodo engancha un evento
+// (variable "alerta" del SensorManager), se manda un mensaje al canal de grupo "SRI", sin necesitar
+// la app ni la PC. Los mensajes de canal no tienen acuse de recibo: se repite 3 veces, cada 20 s.
+//   SRI1 CAIDA dif 7.97g pico 8.79g @25.662300,-100.422100 t1794705000 #3 (1/3)
+// Sin canal "SRI" configurado no se manda nada (la alarma sigue en el nodo y en la PC conectada).
+// ---------------------------------------------------------------------------------------------
+void MyMesh::alertaSRI() {
+  static unsigned long proxima = 0;
+  static uint8_t enviados = 0;
+  static char ultima[64] = "";
+  if (proxima && !millisHasNowPassed(proxima)) return;
+  proxima = futureMillis(1000);
+
+  const char* a = sensors.getSettingByKey("alerta");
+  if (a == NULL || a[0] == 0 || strcmp(a, "-") == 0) { enviados = 0; ultima[0] = 0; return; }
+  if (strcmp(a, ultima) != 0) {                         // evento nuevo: empezar de cero
+    strncpy(ultima, a, sizeof(ultima) - 1);
+    ultima[sizeof(ultima) - 1] = 0;
+    enviados = 0;
+  }
+  if (enviados >= 3) { sensors.setSettingValue("alerta", "0"); return; }
+
+  ChannelDetails ch;
+  int idx = -1;
+#ifdef MAX_GROUP_CHANNELS
+  for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+    if (getChannel(i, ch) && strcmp(ch.name, "SRI") == 0) { idx = i; break; }
+  }
+#endif
+  if (idx < 0) { sensors.setSettingValue("alerta", "0"); return; }
+
+  // "tipo|pico*100|dif*100|epoch|cuenta"
+  char tipo[8] = "?";
+  long pico = 0, dif = 0;
+  unsigned long epoch = 0, cuenta = 0;
+  const char* p = a;
+  int k = 0;
+  while (*p && *p != '|' && k < 7) tipo[k++] = (char)toupper(*p++);
+  tipo[k] = 0;
+  if (*p == '|') pico = strtol(p + 1, (char**)&p, 10);
+  if (*p == '|') dif = strtol(p + 1, (char**)&p, 10);
+  if (*p == '|') epoch = strtoul(p + 1, (char**)&p, 10);
+  if (*p == '|') cuenta = strtoul(p + 1, (char**)&p, 10);
+
+  char pos[40] = "";
+  if (sensors.node_lat != 0 || sensors.node_lon != 0) {
+    // en millonésimas de grado con enteros (no depende de que printf soporte decimales)
+    long la = lround(sensors.node_lat * 1000000.0), lo = lround(sensors.node_lon * 1000000.0);
+    snprintf(pos, sizeof(pos), " @%s%ld.%06ld,%s%ld.%06ld", la < 0 ? "-" : "", labs(la) / 1000000, labs(la) % 1000000,
+             lo < 0 ? "-" : "", labs(lo) / 1000000, labs(lo) % 1000000);
+  }
+  char txt[140];
+  snprintf(txt, sizeof(txt), "SRI1 %s dif %ld.%02ldg pico %ld.%02ldg%s t%lu #%lu (%u/3)", tipo, dif / 100, labs(dif) % 100,
+           pico / 100, labs(pico) % 100, pos, epoch, cuenta, (unsigned)(enviados + 1));
+
+  uint32_t ts = getRTCClock()->getCurrentTimeUnique();
+  if (sendGroupMessage(ts, ch.channel, _prefs.node_name, txt, strlen(txt))) {
+    enviados++;
+    MESH_DEBUG_PRINTLN("SRI: alerta enviada (%u/3): %s", (unsigned)enviados, txt);
+    proxima = futureMillis(enviados < 3 ? 20000 : 1000);
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// SRI: cada 4 minutos el nodo manda su posición GPS por el canal privado "SRI" (no en el anuncio
+// público), para que la base vea dónde va el senderista aunque no haya alerta:
+//   SRI1 POS @25.662300,-100.422100 t1794705000 b3920 e3 a0.92/1.85
+// (t = hora del nodo, b = batería en mV; desde sri4: e = segundos desde la última posición GPS válida,
+//  a = aceleración mínima/máxima en g desde la posición anterior, si el nodo tiene acelerómetro).
+// Solo si hay canal "SRI" y el nodo tiene posición GPS o acelerómetro.
+// Mientras se manda una alerta no se manda posición (la alerta ya lleva la posición).
+// ---------------------------------------------------------------------------------------------
+#ifndef SRI_POS_INTERVALO_MS
+#define SRI_POS_INTERVALO_MS (4UL * 60UL * 1000UL)
+#endif
+void MyMesh::posicionSRI() {
+  static unsigned long proxima = 0;
+  if (proxima == 0) { proxima = futureMillis(60000); return; }   // la primera, 1 min después de encender
+  if (!millisHasNowPassed(proxima)) return;
+
+  const char* a = sensors.getSettingByKey("alerta");
+  if (a != NULL && a[0] != 0 && strcmp(a, "-") != 0 && strcmp(a, "0") != 0) {
+    proxima = futureMillis(30000);                    // hay una alerta saliendo: volver a intentar luego
+    return;
+  }
+  proxima = futureMillis(SRI_POS_INTERVALO_MS);
+
+  // Sin posición GPS y sin acelerómetro no hay nada que mandar (p. ej. FARO). Con acelerómetro se manda el
+  // resumen aunque no haya GPS (posición 0,0, que SRI ignora); "e" dice qué tan vieja es la posición.
+  const char* res = sensors.getSettingByKey("resumen");
+  if (sensors.node_lat == 0 && sensors.node_lon == 0 && (res == NULL || res[0] == '-')) return;
+
+  ChannelDetails ch;
+  int idx = -1;
+#ifdef MAX_GROUP_CHANNELS
+  for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+    if (getChannel(i, ch) && strcmp(ch.name, "SRI") == 0) { idx = i; break; }
+  }
+#endif
+  if (idx < 0) return;
+
+  long la = lround(sensors.node_lat * 1000000.0), lo = lround(sensors.node_lon * 1000000.0);
+  // Resumen del acelerómetro y edad de la posición (sri4): " e<seg> a<mín>/<máx>" (en g, del intervalo)
+  char extra[40] = "";
+  const char* r = sensors.getSettingByKey("resumen");     // "mín*100|máx*100|edad" o "-|-|edad"
+  if (r != NULL && r[0]) {
+    long rmin = 0, rmax = 0, edad = -1;
+    bool hay_acel = r[0] != '-';
+    const char* q = r;
+    if (hay_acel) rmin = strtol(q, (char**)&q, 10);
+    else q = strchr(q, '|');
+    if (q && *q == '|') {
+      if (hay_acel) rmax = strtol(q + 1, (char**)&q, 10);
+      else q = strchr(q + 1, '|');
+    }
+    if (q && *q == '|') edad = strtol(q + 1, NULL, 10);
+    int n = snprintf(extra, sizeof(extra), " e%ld", edad);
+    if (hay_acel && n > 0 && n < (int)sizeof(extra))
+      snprintf(extra + n, sizeof(extra) - n, " a%ld.%02ld/%ld.%02ld", rmin / 100, rmin % 100, rmax / 100, rmax % 100);
+  }
+  char txt[130];
+  snprintf(txt, sizeof(txt), "SRI1 POS @%s%ld.%06ld,%s%ld.%06ld t%lu b%u%s",
+           la < 0 ? "-" : "", labs(la) / 1000000, labs(la) % 1000000,
+           lo < 0 ? "-" : "", labs(lo) / 1000000, labs(lo) % 1000000,
+           (unsigned long)getRTCClock()->getCurrentTime(), (unsigned)board.getBattMilliVolts(), extra);
+  uint32_t ts = getRTCClock()->getCurrentTimeUnique();
+  if (sendGroupMessage(ts, ch.channel, _prefs.node_name, txt, strlen(txt))) {
+    sensors.setSettingValue("resumen", "0");
+    MESH_DEBUG_PRINTLN("SRI: posición enviada: %s", txt);
+  } else {
+    proxima = futureMillis(30000);
+  }
 }
 
