# --- Datos personales y de pruebas (ubicaciones, huellas Wi-Fi, identidad del nodo) ---
data/

# --- Entornos de Python (se reinstalan con requirements.txt) ---
.venv/
firmware/.venv-pio/
__pycache__/
*.pyc

# --- Firmware: copia de MeshCore (otro proyecto, 370 MB) y bitácoras de compilación ---
