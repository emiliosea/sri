#!/bin/bash
# Ventana de la estación SRI: abre la interfaz a pantalla completa (sin barras del navegador) y la vuelve a
# abrir si se cierra. El seguimiento lo hace el servicio "sri"; esta ventana solo lo muestra.
#
#   sri-kiosco              pantalla completa (se reabre sola)
#   sri-kiosco --ventana    ventana normal, una sola vez (para probar)
#   sri-kiosco --pausar     cierra la ventana y no la reabre (mantenimiento)
#   sri-kiosco --reanudar   vuelve a abrirla
set -u

CONF="${SRI_CONFIG:-/etc/sri/config.toml}"
PUERTO="$(grep -oP '^\s*puerto\s*=\s*\K[0-9]+' "$CONF" 2>/dev/null | head -1)"
URL="${SRI_URL:-http://localhost:${PUERTO:-5000}/}"
DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sri-kiosco"
PAUSA="$DIR/pausado"
mkdir -p "$DIR"

case "${1:-}" in
  --pausar)   touch "$PAUSA"; pkill -f -- "--user-data-dir=$DIR/perfil" || true; pkill -f -- "-profile $DIR/perfil-ff" || true
              echo "Ventana SRI en pausa. Para volver: sri-kiosco --reanudar"; exit 0 ;;
  --reanudar) rm -f "$PAUSA"; echo "Listo. Se abrirá la próxima vez que corra sri-kiosco (o al iniciar sesión)."
              exec "$0" ;;
esac

MODO_VENTANA=0; [ "${1:-}" = "--ventana" ] && MODO_VENTANA=1

# Esperar a que el servicio responda (hasta 2 min)
for _ in $(seq 1 120); do
  curl -fs -o /dev/null "${URL}api/nodes" && break
  sleep 1
done

abrir() {
  if command -v chromium >/dev/null || command -v chromium-browser >/dev/null; then
    local NAV; NAV="$(command -v chromium || command -v chromium-browser)"
    local EXTRA=(--kiosk); [ "$MODO_VENTANA" = 1 ] && EXTRA=(--window-size=1280,800)
    "$NAV" --app="$URL" "${EXTRA[@]}" --user-data-dir="$DIR/perfil" --no-first-run --noerrdialogs \
      --disable-infobars --disable-session-crashed-bubble --disable-features=Translate \
      --password-store=basic --check-for-update-interval=31536000 --overscroll-history-navigation=0
  elif command -v firefox-esr >/dev/null || command -v firefox >/dev/null; then
    local NAV; NAV="$(command -v firefox-esr || command -v firefox)"
    mkdir -p "$DIR/perfil-ff"
    if [ "$MODO_VENTANA" = 1 ]; then "$NAV" -no-remote -profile "$DIR/perfil-ff" "$URL"
    else "$NAV" -no-remote -profile "$DIR/perfil-ff" --kiosk "$URL"; fi
  else
    echo "No se encontró Chromium ni Firefox. Instala uno: sudo apt install chromium" >&2
    return 1
  fi
}

if [ "$MODO_VENTANA" = 1 ]; then abrir; exit $?; fi
while [ ! -e "$PAUSA" ]; do
  abrir || exit 1
  [ -e "$PAUSA" ] && break
  sleep 3            # si se cerró (o falló), reabrir
done
