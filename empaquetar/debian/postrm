#!/bin/sh
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  rm -f /etc/xdg/autostart/sri-kiosco.desktop
fi
# Los datos en /var/lib/sri se conservan al desinstalar; "purge" los borra.
if [ "$1" = "purge" ]; then
  rm -rf /var/lib/sri
  getent passwd sri >/dev/null && deluser --system sri >/dev/null 2>&1 || true
fi
[ -d /run/systemd/system ] && systemctl daemon-reload || true
exit 0
